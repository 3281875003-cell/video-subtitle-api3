<!--pages/index/index.wxml-->
<view class="container">
  <!-- 标题区域 -->
  <view class="header">
    <view class="title">视频字幕提取</view>
    <view class="subtitle">免费提取公开视频的字幕/文案</view>
  </view>

  <!-- 输入区域 -->
  <view class="input-section">
    <view class="input-box">
      <textarea 
        value="{{videoUrl}}" 
        bindinput="onUrlInput" 
        placeholder="粘贴视频链接（支持抖音、B站、YouTube等）" 
        auto-height 
        maxlength="500"
      />
    </view>
    
    <view class="btn-group">
      <button class="btn-paste" bindtap="onPaste">粘贴链接</button>
      <button class="btn-extract" bindtap="onExtract" loading="{{loading}}">
        {{loading ? loadingText : '提取字幕'}}
      </button>
    </view>
  </view>

  <!-- 使用提示 -->
  <view class="tips">
    <view class="tips-title">使用提示：</view>
    <view class="tips-item">✅ 支持平台：抖音、快手、B站、YouTube、TikTok等</view>
    <view class="tips-item">✅ 直接粘贴分享文本，自动识别链接</view>
    <view class="tips-item">✅ 仅支持公开视频，私有视频无法提取</view>
  </view>

  <!-- 加载动画 -->
  <view class="loading-mask" wx:if="{{loading}}">
    <view class="loading-box">
      <view class="spinner"></view>
      <view class="loading-text">{{loadingText}}</view>
    </view>
  </view>
</view>